  "cards": [
    {
      "dot": "cyan",
      "title": "案例：一次理想调用",
      "items": [
        "用户：上传《服务协议.docx》，问\"付款周期是多少？\"",
        "模型生成：file.search({ query: \"付款周期\" })。",
        "解析与 Schema 通过 → 权限门 allow → 检索命中 seg_123。",
        "file.read 回读原文、登记 Evidence → 带引用回答〔第 5 页〕。"
      ]
    },
    {
      "dot": "amber",
      "title": "第 1 层｜模型输出：4 个 Cases",
      "items": [
        "A 正常：工具名、JSON、字段值都合理 → 进入框架。",
        "B JSON 损坏：截断、引号错误、包裹层错误 → 解析失败，不执行 Tool。",
        "C 幻觉工具名：file.locate 不在注册表 → UNKNOWN_TOOL。",
        "D 流式参数未聚合：增量片段被直接执行 → 必须先聚合再重建完整调用。"
      ]
    },
    {
      "dot": "amber",
      "title": "第 2 层｜框架解析与 Schema：5 个 Cases",
      "items": [
        "A 解析成功：提取 tool name 与 arguments。",
        "B 缺字段：file.read 缺 segmentId → required error。",
        "C 类型错误：page: \"5\"（字符串）→ 期望 integer。",
        "D 自然语言当 ID：segmentId: \"刚才第二段\" → 位置必须来自系统生成的 ID。",
        "E 多余字段：additionalProperties: false 直接拒绝。",
        "F 低风险修复：page \"5\"→5 可自动转换；segmentId 永不自动猜。"
      ]
    },
    {
      "dot": "violet",
      "title": "第 3 层｜Tool 开发者：必须二次校验",
      "items": [
        "A NOT_READY：文件还在解析中——是\"稍候\"，不是\"没有\"。",
        "B NO_MATCH：文件里没有相关内容——换措辞重试无意义。",
        "C NOT_FOUND：seg_999 不存在或不属于当前 Revision。",
        "D PERMISSION_DENIED：Attachment 不属于当前用户 / Session。",
        "E CONFLICT：Revision 已被替换——刷新引用后重试。",
        "F 服务端鉴权不能交给模型。"
      ]
    },
    {
      "dot": "violet",
      "title": "第 4 层｜服务端与外部系统：4 个 Cases",
      "items": [
        "A 200 成功：返回 Segment 原文 + Evidence。",
        "B timeout / 5xx：只读检索可自由重试；registerUpload 超时 = 结果未知，同幂等键重放。",
        "C 429：遵循 Retry-After，退避后重试。",
        "D 干净失败 vs 结果未知：幂等缓存的分界（Stripe 范式）。"
      ]
    },
    {
      "dot": "rose",
      "title": "第 5 层｜恢复、反馈、终止：5 个 Cases",
      "items": [
        "A 结构化反馈：把 code、message、retryable、details 返回给模型。",
        "B 模型修正：Anthropic 载明 retry 2-3 次 with corrections。",
        "C 修复环：repairToolCall 在当前步内修复，不污染消息历史。",
        "D 终止收口：partial / unable_to_confirm / failed 都是合法终点。",
        "E 重试有预算：知道何时停（0.45）远大于机械重试（0.05）。"
      ]
    },
    {
      "dot": "rose",
      "title": "最终责任边界｜一句话记忆",
      "items": [
        "模型负责：提出意图与参数，依据反馈尝试修正。",
        "Agent 框架负责：解析调用、运行 Schema、传递错误、编排重试；这些不一定默认自动发生。",
        "Tool 负责：业务二次校验、幂等键、错误结构化。",
        "服务端负责：最终鉴权与安全边界，deny 先于一切放行。",
        "Audit 负责：独立于模型的记录——Replit 事故证明模型自我报告不可信。"
      ]
    }
  ]
}