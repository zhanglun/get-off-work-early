  "cards": [
    { "dot": "cyan", "title": "读图方法｜先看成功，再看失败分类", "items": ["案例输入：取消 ORD-42，但仅当订单未发货。", "成功路径：用户 → LLM → Runtime → Schema → Tool → Policy/Auth → 订单服务 → Recovery → 用户。", "虚线表示格式化、异步审计或重试；红色/安全色表示拒绝或不可执行。", "点击上方 Guided Views 可聚焦成功链路、结构错误、业务安全或故障恢复。"] },
    { "dot": "amber", "title": "模型与协议层｜失败不止是参数错误", "items": ["正常 Case：生成 cancel_order({ order_id: \"ORD-42\", reason: \"user_request\" })。", "JSON 损坏、未知工具名：Runtime 在执行前拒绝。", "模型只有收到 PARSE_ERROR/UNKNOWN_TOOL 后，才可能在下一轮尝试修正。", "语义看似合理不代表资源存在、权限足够或状态允许。"] },
    { "dot": "violet", "title": "Runtime + Schema｜执行前的结构防线", "items": ["解析器检查 tool name、JSON、调用 envelope。", "Schema 检查 required、type、enum、长度、范围和额外字段。", "校验失败应产生带 path、expected、received 的结构化错误。", "是否自动反馈模型、是否自动重试，不是 Tool 机制必然保证，取决于框架/编排代码。", "低风险可转换可以规范化；高风险字段不要静默猜测。"] },
    { "dot": "rose", "title": "Tool + 服务端｜业务与安全最终兜底", "items": ["Tool 内部二次验证订单存在性、业务状态、调用权限和幂等性。", "服务端必须再次鉴权、执行事务、检查状态机和限额。", "Schema 合法只说明参数形状合法，不说明操作被允许。", "try/catch、timeout、取消、第三方错误必须转成 Tool Result，不能让 Agent 直接崩溃。"] },
    { "dot": "orange", "title": "Recovery｜分层重试、降级与终止", "items": ["参数错误：反馈明确错误，让模型修正；不要无限循环。", "timeout/5xx：retryable=true，指数退避并限制次数。", "永久业务拒绝：retryable=false，不要盲目重试。", "达到预算或高风险：询问用户、人工审批、熔断或降级。", "最终回复必须解释成功、失败原因或下一步。"] },
    { "dot": "emerald", "title": "全局结论｜失败处理的责任边界", "items": ["模型：提出意图与参数；根据反馈尝试修正。", "Agent 框架：解析、调用 Schema、传递错误、编排重试。", "Tool 开发者：业务规则、资源、权限、状态、幂等、异常捕获。", "服务端：最终鉴权、事务一致性和不可绕过的安全边界。", "原则：不要相信模型参数；不要只相信 Schema；不要把权限交给模型；不要无限重试。"] }
  ]
}
