{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Agent Tools 调用失败：全生命周期处理",
    "subtitle": "案例：用户请求取消 ORD-42。覆盖模型、Runtime、Schema、Tool、服务端、结果校验、重试、降级、审批与审计。",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1500, 1700],
    "views": [
      { "id": "happy", "label": "成功主链路", "focus": ["user", "llm", "runtime", "schema", "tool", "service", "recovery"], "note": "一次合法调用如何通过所有防线并返回成功结果。" },
      { "id": "shape", "label": "结构参数 Cases", "focus": ["llm", "runtime", "schema", "recovery"], "note": "JSON 损坏、未知工具、缺字段、类型错、枚举错和低风险自动修复。" },
      { "id": "business", "label": "业务安全 Cases", "focus": ["runtime", "schema", "tool", "auth", "service", "recovery"], "note": "Schema 通过后，工具与服务端仍必须验证资源、权限、状态与幂等。" },
      { "id": "outage", "label": "故障恢复 Cases", "focus": ["tool", "service", "recovery", "audit"], "note": "区分临时故障与永久错误，有限重试、熔断、降级和升级。" },
      { "id": "responsibility", "label": "责任边界", "focus": ["llm", "runtime", "schema", "tool", "service", "recovery", "audit"], "note": "模型、框架、Tool 开发者和服务端各自负责什么。" }
    ]
  },
  "participants": [
    { "id": "user", "type": "external", "label": "用户/UI", "sublabel": "自然语言请求" },
    { "id": "llm", "type": "backend", "label": "LLM", "sublabel": "意图与参数" },
    { "id": "runtime", "type": "backend", "label": "Agent Runtime", "sublabel": "解析与编排" },
    { "id": "schema", "type": "security", "label": "Schema Guard", "sublabel": "结构校验" },
    { "id": "tool", "type": "backend", "label": "Tool", "sublabel": "开发者实现" },
    { "id": "auth", "type": "security", "label": "Policy/Auth", "sublabel": "权限与业务规则" },
    { "id": "service", "type": "cloud", "label": "订单服务", "sublabel": "API + DB" },
    { "id": "recovery", "type": "messagebus", "label": "Recovery", "sublabel": "反馈/重试/降级" },
    { "id": "audit", "type": "database", "label": "Trace/Audit", "sublabel": "审计与观测" }
  ],
  "segments": [
    { "from": 150, "to": 360, "label": "A · 一次成功调用" },
    { "from": 390, "to": 850, "label": "B · 模型、协议与解析失败" },
    { "from": 880, "to": 1250, "label": "C · Schema、业务与权限失败" },
    { "from": 1280, "to": 1510, "label": "D · 执行故障、结果与恢复" },
    { "from": 1540, "to": 1650, "label": "E · 编排、审计与责任边界" }
  ],
  "messages": [
    { "id": "m01", "from": "user", "to": "llm", "y": 180, "label": "取消 ORD-42（若未发货）", "variant": "emphasis" },
    { "id": "m02", "from": "llm", "to": "runtime", "y": 225, "label": "Tool Call: cancel_order(args)", "variant": "emphasis", "note": "模型输出的是尝试性调用，不是安全保证" },
    { "id": "m03", "from": "runtime", "to": "schema", "y": 270, "label": "解析 tool name + arguments", "variant": "default" },
    { "id": "m04", "from": "schema", "to": "tool", "y": 315, "label": "通过：required/type/enum", "variant": "emphasis" },
    { "id": "m05", "from": "tool", "to": "auth", "y": 375, "label": "业务存在性 + 权限 + 状态", "variant": "security" },
    { "id": "m06", "from": "auth", "to": "service", "y": 405, "label": "授权且可取消：受控执行", "variant": "emphasis" },
    { "id": "m07", "from": "service", "to": "recovery", "y": 450, "label": "200：事务成功 + order", "variant": "return" },
    { "id": "m08", "from": "recovery", "to": "llm", "y": 495, "label": "Tool Result: ok=true", "variant": "return" },
    { "id": "m09", "from": "llm", "to": "user", "y": 540, "label": "已取消 ORD-42", "variant": "return" },
    { "id": "m10", "from": "runtime", "to": "recovery", "y": 585, "label": "审计：调用、参数、耗时", "variant": "dashed" },
    { "id": "m11", "from": "recovery", "to": "audit", "y": 630, "label": "append trace event", "variant": "dashed" },
    { "id": "m12", "from": "llm", "to": "runtime", "y": 690, "label": "Case B：JSON 截断 / envelope 错", "variant": "security" },
    { "id": "m13", "from": "runtime", "to": "recovery", "y": 735, "label": "PARSE_ERROR；不执行 Tool", "variant": "security" },
    { "id": "m14", "from": "llm", "to": "runtime", "y": 780, "label": "Case C：未知工具名", "variant": "security" },
    { "id": "m15", "from": "runtime", "to": "recovery", "y": 825, "label": "UNKNOWN_TOOL；不执行 Tool", "variant": "security" },
    { "id": "m16", "from": "runtime", "to": "schema", "y": 900, "label": "Case D：缺字段 / 类型错 / enum 错", "variant": "security" },
    { "id": "m17", "from": "schema", "to": "recovery", "y": 945, "label": "VALIDATION_ERROR + path + expected", "variant": "security" },
    { "id": "m18", "from": "schema", "to": "runtime", "y": 990, "label": "Case E：低风险可转换（\"30\"→30）", "variant": "dashed" },
    { "id": "m19", "from": "runtime", "to": "tool", "y": 1035, "label": "规范化参数；记录原值与新值", "variant": "dashed" },
    { "id": "m20", "from": "schema", "to": "recovery", "y": 1080, "label": "高风险/不可修复：拒绝静默修复", "variant": "security" },
    { "id": "m21", "from": "recovery", "to": "llm", "y": 1125, "label": "错误反馈：code/message/details", "variant": "return" },
    { "id": "m22", "from": "llm", "to": "runtime", "y": 1170, "label": "下一轮尝试修正参数", "variant": "dashed", "note": "模型只能根据反馈被动修正，不能保证成功" },
    { "id": "m23", "from": "tool", "to": "auth", "y": 1230, "label": "Case F：订单不存在 / 无权限 / 状态非法", "variant": "security" },
    { "id": "m24", "from": "auth", "to": "recovery", "y": 1275, "label": "ORDER_NOT_FOUND / PERMISSION_DENIED / INVALID_STATE", "variant": "security" },
    { "id": "m25", "from": "tool", "to": "service", "y": 1335, "label": "Case G：幂等键 + 服务端再次鉴权", "variant": "emphasis" },
    { "id": "m26", "from": "service", "to": "recovery", "y": 1380, "label": "Case H：timeout / 5xx；retryable=true", "variant": "dashed" },
    { "id": "m27", "from": "service", "to": "recovery", "y": 1410, "label": "Case I：永久业务拒绝；retryable=false", "variant": "security" },
    { "id": "m28", "from": "recovery", "to": "runtime", "y": 1450, "label": "最多 2–3 次：参数修正或指数退避", "variant": "dashed" },
    { "id": "m29", "from": "recovery", "to": "user", "y": 1495, "label": "达到上限：询问/人工审批/失败解释", "variant": "return" },
    { "id": "m30", "from": "recovery", "to": "service", "y": 1525, "label": "连续故障：熔断/降级，停止继续调用", "variant": "security" },
    { "id": "m31", "from": "runtime", "to": "audit", "y": 1570, "label": "写入审计事件", "variant": "dashed" },
    { "id": "m32", "from": "audit", "to": "user", "y": 1610, "label": "可解释结果", "variant": "return" }
  ],
