# 默认 mock 模式无需 API Key，即可跑通完整链路。
LLM_MODE=mock

# real 模式使用 Mastra model router；请按所选 provider 配置对应变量。
# OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-5.6-sol

# 业务数据库：目标为 PostgreSQL + Prisma
# 本地还没有启动 PostgreSQL 时，示例脚本使用内存 Repository。
# 真正启用 Prisma Repository 时必须配置。
DATABASE_URL=postgresql://short_drama:short_drama@localhost:5434/short_drama
STORAGE_MODE=memory

# 可选：限制每镜审查-改写轮数和并发
MAX_ROUNDS=3
CONCURRENCY=3
